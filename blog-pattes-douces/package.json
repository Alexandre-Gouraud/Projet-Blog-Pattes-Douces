{
  "name": "blog-pattes-douces",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "translation:setup": "node scripts/translation-assets.mjs",
    "db:up": "docker compose up -d --wait",
    "db:push": "prisma db push",
    "db:down": "docker compose down",
    "docker:up": "docker compose --profile app up -d --build --wait",
    "docker:down": "docker compose --profile app down"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ],
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "undici@<6.29.1": "6.29.1",
      "zod@<4.6.6": "4.6.6"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
