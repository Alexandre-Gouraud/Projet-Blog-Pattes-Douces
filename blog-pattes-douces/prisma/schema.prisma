generator client {
  provider = "prisma-client-js"
}
 
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
 
model User {
  id  String   @id @default(auto()) @map("_id") @db.ObjectId
  pseudo  String @unique
  biographie String?  
  // Cle d'espece (cat, dog, rabbit, kitten, puppy, pet) affichee a cote du pseudo.
  espece String?
  email  String  @unique
  password String
 
  articles Article[]
  commentaires Commentaire[]
  sessions Session[]

}

// Session serveur : seul le hash SHA-256 du jeton (cookie pd_session) est stocke.
model Session {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.ObjectId

  @@index([userId])
  @@index([expiresAt])
}
 
model Article{
  id String   @id @default(auto()) @map("_id") @db.ObjectId
  titre String
  texte String
  image String?
  // Langue de redaction (fr, en, ar, zh) : attribut lang du contenu (RGAA 8.7).
  langue String?
  date DateTime @default(now())
  vue         String[]
  reaction1   String[]
  reaction2   String[]
 
  auteur User @relation(fields: [auteurId], references: [id])
  auteurId  String @db.ObjectId
 
  commentaires Commentaire[]
 
 
}
 
model Commentaire{
  id String   @id @default(auto()) @map("_id") @db.ObjectId
  texte String
  langue String?
  date DateTime @default(now())
  reaction1   String[]
  reaction2   String[]
 
 article_source Article @relation(fields: [article_sourceId],references: [id])
 article_sourceId String @db.ObjectId
 
  commentataire User @relation(fields: [commentataireId], references: [id])
  commentataireId  String @db.ObjectId
}
 
enum Reactions{
  Like
  Dislike
}
