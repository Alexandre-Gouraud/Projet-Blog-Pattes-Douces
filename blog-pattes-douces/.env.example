# Copier ce fichier en .env (jamais commite : voir .gitignore) puis renseigner les valeurs.

# Base MongoDB utilisee par Prisma. Elle DOIT tourner en replica set (Prisma
# utilise des transactions) : un mongod lance seul fait echouer les ecritures.
# Local (docker compose up -d --wait) :
DATABASE_URL="mongodb://localhost:27017/pattes-douces?replicaSet=rs0&directConnection=true"
# Atlas (deja en replica set) :
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/pattes-douces?retryWrites=true&w=majority"

# Jeton Vercel Blob, utilise par POST /api/uploads pour stocker les images d'article.
# Se recupere dans le dashboard Vercel : Storage > Blob > Tokens.
# Sans lui, tout fonctionne sauf la publication d'un article depuis l'interface
# (le formulaire exige une image) : POST /api/uploads repond 503.
BLOB_READ_WRITE_TOKEN=""

# Attribut Secure du cookie de session : "true" ou "false". Laisser vide / commente :
# vrai en production, faux en developpement. A mettre a "false" uniquement pour servir
# l'image Docker en http simple (un cookie Secure y est refuse hors localhost).
# Ne jamais le desactiver derriere un vrai site : utiliser HTTPS.
# COOKIE_SECURE=false

# Limitation des tentatives de connexion et d'inscription.
# TRUST_PROXY="true" UNIQUEMENT derriere un reverse proxy de confiance qui ajoute l'adresse du
# client en fin de X-Forwarded-For : la limite s'applique alors par IP + pseudo (5), par IP (20)
# et a l'inscription (20 par IP). Sinon (defaut) l'en-tete est falsifiable et ignore, aucune
# cle IP n'est utilisee : seule une limite par pseudo (10 echecs en 15 min) s'applique, et
# quiconque connait un pseudo peut donc le verrouiller 15 min. Avec TRUST_PROXY, une attaque
# repartie sur de nombreuses IP n'est pas limitee globalement.
# TRUST_PROXY="true"

# Secret facultatif : les cles de limitation deviennent des HMAC-SHA-256 (sinon SHA-256 simple).
# Dans les deux cas elles sont pseudonymisees, pas anonymes.
# THROTTLE_SECRET=""
